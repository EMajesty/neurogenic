export global Theme {
    out property <color> background: #11151a;
    out property <color> panel: #1c232b;
    out property <color> foreground: #f0f4f7;
    out property <color> muted: #87939e;
    out property <color> accent: #57c7d4;
    out property <color> selected: #355f67;
    out property <color> warning: #e3a954;
    out property <length> spacing: 10px;
    out property <length> radius: 5px;
}
