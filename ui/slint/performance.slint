import { PageButton, ContextualEncoder, ContextualFunctionButton, GlobalStatus, EmptyState, Notification, ModalDialog, ParameterDisplay, TouchKeyboard } from "components.slint";
import { Theme } from "theme.slint";
import { PerformancePage, PadItem, SceneItem } from "performance_page.slint";
import { SequencerPage, StepItem, PatternItem, ArrangementItem, TrackItem } from "sequencer_page.slint";
import { SamplePage, SliceItem, RegionItem } from "sample_page.slint";
import { SoundPage, SoundParameterItem, SoundModulationItem } from "sound_page.slint";
import { MixerPage, MixerChannelItem, MixerFxItem } from "mixer_page.slint";
import { FxPage, FxOwnerItem, FxInstanceItem, FxParameterItem, FxModulatorItem, FxRouteItem, FxMacroItem } from "fx_page.slint";
import { BrowserPage, BrowserEntryItem } from "browser_page.slint";
import { SetupPage, SetupDeviceItem, SetupControllerItem, SetupMidiRouteItem, SetupMappingItem } from "setup_page.slint";

export struct ContextItem { label: string, value: string, unit: string, active: bool }
export struct PageItem { id: string, title: string, implemented: bool }

export component PerformanceWindow inherits Window {
    title: "NEUROGENIC"; preferred-width: 1280px; preferred-height: 800px;
    min-width: 1024px; min-height: 600px; background: Theme.background;
    in property <string> project-name: "Untitled";
    in property <bool> project-dirty: false;
    in property <string> transport-state: "Stopped";
    in property <string> tempo: "120 BPM";
    in property <string> time-signature: "4/4";
    in property <string> position: "1.1.0";
    in property <string> page-id: "performance";
    in property <string> page-title: "Performance";
    in property <string> selected-track: "Unavailable";
    in property <string> track-owner: "Arrangement";
    in property <string> active-content: "Unavailable";
    in property <string> launch-quantization: "Bar";
    in property <string> notification: "";
    in property <bool> arrangement-view: false;
    in property <string> selected-pattern: "Unavailable";
    in property <string> pattern-length: "Unavailable";
    in property <string> step-resolution: "1/16";
    in property <string> selected-velocity: "--";
    in property <string> selected-duration: "--";
    in property <string> selected-pitch: "--";
    in property <string> selected-probability: "--";
    in property <string> selected-condition: "--";
    in property <string> selected-ratchet: "--";
    in property <string> selected-timing: "--";
    in property <string> step-page-label: "Page 1/1";
    in property <string> step-lock-parameter: "Unavailable";
    in property <string> step-lock-value: "--";
    in property <bool> step-lock-available: false;
    in property <bool> playhead-follow: false;
    in property <bool> can-page-previous: false;
    in property <bool> can-page-next: false;
    in property <bool> confirm-delete-track: false;
    in property <bool> confirm-delete-pattern: false;
    in property <[TrackItem]> sequencer-tracks;
    in property <string> arrangement-loop: "Off";
    in property <int> sample-slot: 0;
    in property <string> sample-name: "Empty slot";
    in property <string> sample-status: "Empty";
    in property <string> sample-metadata: "Unavailable";
    in property <string> sample-error: "";
    in property <string> analysis-status: "Idle";
    in property <string> processing-status: "Idle";
    in property <float> processing-progress: 0;
    in property <bool> processing-can-cancel: false;
    in property <bool> processing-can-publish: false;
    in property <bool> processing-audio-active: false;
    in-out property <string> processing-result-path: "";
    in property <bool> sample-ready: false;
    in property <bool> sample-stereo: false;
    in property <float> waveform-zoom: 1;
    in property <[float]> waveform-left;
    in property <[float]> waveform-right;
    in property <[float]> slice-markers;
    in property <float> region-start: 0;
    in property <float> region-end: 1;
    in property <[PageItem]> pages;
    in property <[ContextItem]> encoders;
    in property <[ContextItem]> functions;
    in property <[PadItem]> pads;
    in property <[SceneItem]> scenes;
    in property <[StepItem]> steps;
    in property <[PatternItem]> patterns;
    in property <[ArrangementItem]> arrangement-items;
    in property <[SliceItem]> sample-slices;
    in property <[RegionItem]> sample-regions;
    in-out property <string> sample-path: "";
    in property <string> sound-track: "Unavailable";
    in property <string> sound-instrument: "None";
    in property <string> sound-instrument-id: "";
    in property <bool> sound-instrument-available: false;
    in property <bool> sound-is-synth: false;
    in property <bool> sound-is-sample: false;
    in property <string> sound-subview: "instrument";
    in property <[SoundParameterItem]> sound-parameters;
    in property <[SoundModulationItem]> sound-modulation;
    in property <int> sound-selected-parameter: 0;
    in property <int> sound-selected-modulation: 0;
    in property <string> sound-sample-mode: "Unavailable";
    in property <string> sound-sample-envelope: "--";
    in property <string> sound-sample-tuning: "--";
    in property <string> sound-preset-status: "idle";
    in property <string> sound-error: "";
    in-out property <string> sound-preset-library: "";
    in-out property <string> sound-preset-id: "";
    in property <[MixerChannelItem]> mixer-channels;
    in property <[MixerFxItem]> mixer-external-fx;
    in property <int> mixer-bank: 0;
    in property <string> mixer-bank-label: "Channels 1-8";
    in property <int> mixer-selected-channel: 0;
    in property <string> mixer-error: "";
    in property <string> fx-subview: "chain"; in property <string> fx-owner-name: "Unavailable";
    in property <bool> fx-chain-bypass: false; in property <string> fx-error: "";
    in property <[FxOwnerItem]> fx-owners; in property <[FxInstanceItem]> fx-effects;
    in property <[FxParameterItem]> fx-parameters; in property <[FxModulatorItem]> fx-modulators;
    in property <[FxRouteItem]> fx-routes; in property <[FxMacroItem]> fx-macros;
    in property <string> browser-category: "projects"; in property <string> browser-location: "";
    in property <string> browser-destination: "Current project"; in property <string> browser-preview: "No selection";
    in property <string> browser-sort: "name"; in property <string> browser-error: "";
    in property <bool> browser-truncated: false; in property <[BrowserEntryItem]> browser-entries;
    in property <bool> browser-loading: false; in property <string> browser-page-label: "Page 1/1";
    in property <bool> browser-can-previous-page: false; in property <bool> browser-can-next-page: false;
    in property <[string]> browser-missing-assets; in property <int> browser-selected-missing: 0;
    in property <bool> browser-confirmation-pending: false; in property <string> browser-confirmation-message: "";
    in-out property <string> browser-filter: ""; in-out property <string> browser-project-path: "";
    in property <bool> text-entry-visible: false; in property <string> text-entry-title: "";
    in property <string> text-entry-value: ""; in property <int> text-entry-cursor: 0;
    in property <string> text-entry-error: ""; in property <bool> text-entry-uppercase: false;
    in property <bool> text-entry-symbols: false;
    in property <string> setup-subview: "audio"; in property <string> setup-audio-backend: "Unavailable";
    in property <string> setup-audio-status: "Unavailable"; in property <string> setup-active-input: "Unavailable";
    in property <string> setup-active-output: "Unavailable"; in property <string> setup-requested-input: "";
    in property <string> setup-requested-output: ""; in property <int> setup-sample-rate: 48000;
    in property <int> setup-active-buffer: 0; in property <int> setup-requested-buffer: 256;
    in property <int> setup-active-input-channels: 0; in property <int> setup-active-output-channels: 0;
    in property <int> setup-requested-input-channels: 2; in property <int> setup-requested-output-channels: 2;
    in property <bool> setup-restart-required: false; in property <bool> setup-pending: false;
    in property <bool> setup-fullscreen: false; in property <bool> setup-reopen-last-project: false;
    in property <float> setup-ui-scale: 1; in property <string> setup-startup-project: "";
    in property <string> setup-midi-clock: "Internal"; in property <string> setup-system: "Unknown";
    in property <string> setup-version: "Unknown"; in property <float> setup-callback-load: 0;
    in property <float> setup-callback-peak: 0; in property <int> setup-xruns: 0;
    in property <bool> setup-xruns-available: false; in property <string> setup-error: "";
    in property <string> setup-learn-status: "Idle"; in property <[SetupDeviceItem]> setup-audio-inputs;
    in property <[SetupDeviceItem]> setup-audio-outputs; in property <[SetupDeviceItem]> setup-midi-inputs;
    in property <[SetupDeviceItem]> setup-midi-outputs; in property <[SetupControllerItem]> setup-controllers;
    in property <[SetupMidiRouteItem]> setup-midi-routes;
    in property <[SetupMappingItem]> setup-mappings;
    in-out property <string> setup-learn-control: "encoder.1"; in-out property <string> setup-learn-mode: "cc-absolute";
    in-out property <string> setup-profile-path: "";
    in-out property <bool> modal-visible: false;
    in property <bool> recording-visible: false;
    in property <string> recording-mode: "External audio";
    in property <string> recording-phase: "Idle";
    in property <string> recording-source: "external-stereo";
    in property <string> recording-destination: "Sample slot 0";
    in property <string> recording-quantization: "immediate";
    in property <string> recording-error: "";
    in property <bool> recording-can-arm: false;
    in property <bool> recording-can-start: false;
    in property <bool> recording-can-stop: false;
    in property <bool> recording-can-cancel: false;
    in property <bool> recording-can-commit: false;
    in property <float> recording-progress: 0;
    in property <int> recording-overflows: 0;
    callback encoder-turned(int, int); callback function-invoked(int);
    callback pad-invoked(int, bool); callback keyboard-input(string, bool);
    callback page-selected(int); callback transport-invoked(string);
    callback track-selected(int); callback return-arrangement();
    callback scene-invoked(int); callback notification-dismissed();
    callback quantization-invoked();
    callback sequencer-step-invoked(int); callback pattern-invoked(int, bool);
    callback pattern-create(bool); callback resolution-invoked();
    callback arrangement-toggle(); callback arrangement-item-invoked(int);
    callback step-edit(string);
    callback step-page(int); callback playhead-follow-changed(bool);
    callback advanced-step-edit(string, int); callback condition-cycle();
    callback lock-parameter-cycle(int); callback lock-edit(string, int);
    callback track-item-selected(int); callback track-manage(string); callback pattern-manage(string);
    callback sample-slot-selected(int); callback sample-load(string); callback sample-browse-requested();
    callback waveform-selected(float); callback waveform-zoomed(float);
    callback slice-selected(int); callback slice-action(string);
    callback region-selected(int); callback region-action(string);
    callback sample-preview(string); callback sample-analysis(string);
    callback sample-processing(string);
    callback processing-lifecycle(string, string);
    callback recording-action(string);
    callback recording-mode-selected(string);
    callback recording-source-selected(string);
    callback recording-quantization-selected(string);
    callback recording-closed();
    callback sound-subview-selected(string); callback sound-instrument-selected(string);
    callback sound-parameter-selected(int); callback sound-parameter-adjusted(int, int);
    callback sound-sample-action(string); callback sound-modulation-selected(int);
    callback sound-modulation-action(string); callback sound-preset-action(string, string, string);
    callback mixer-channel-selected(int); callback mixer-bank-changed(int);
    callback mixer-adjust(string, int); callback mixer-toggle(string); callback mixer-route-cycle(); callback mixer-group-cycle();
    callback mixer-fx-selected(int); callback mixer-fx-adjust(string, int); callback mixer-fx-toggle(string);
    callback fx-subview-selected(string); callback fx-owner-selected(int); callback fx-effect-selected(int);
    callback fx-effect-add(string); callback fx-effect-action(string); callback fx-parameter-selected(int); callback fx-parameter-adjusted(int);
    callback fx-modulator-selected(int); callback fx-route-selected(int); callback fx-route-action(string); callback fx-route-create();
    callback fx-macro-selected(int); callback fx-macro-adjusted(int);
    callback browser-category-selected(string); callback browser-parent(); callback browser-entry-selected(int);
    callback browser-activate(); callback browser-filter-requested(string); callback browser-sort-requested();
    callback browser-project-action(string, string); callback browser-preset-action(string);
    callback browser-confirm(bool);
    callback browser-page-requested(int); callback browser-refresh-requested();
    callback browser-missing-selected(int); callback browser-relink-requested(bool);
    callback text-entry-requested(string, string); callback text-entry-insert(string);
    callback text-entry-action(string);
    callback setup-subview-selected(string); callback setup-device-selected(string, int);
    callback setup-value-adjusted(string, int); callback setup-preference-toggled(string);
    callback setup-preferences-action(string); callback setup-controller-selected(int);
    callback setup-midi-learn(string, string, string); callback setup-profile-save(string); callback setup-exit();
    callback setup-midi-route-selected(int); callback setup-midi-route-action(string);
    callback setup-mapping-selected(int); callback setup-mapping-remove();

    FocusScope { key-pressed(event) => { root.keyboard-input(event.text, true); accept } key-released(event) => { root.keyboard-input(event.text, false); accept } }
    VerticalLayout {
        padding: 8px; spacing: 6px;
        GlobalStatus { height: 48px; project: root.project-name; dirty: root.project-dirty; transport: root.transport-state; tempo: root.tempo; signature: root.time-signature; position: root.position; page-title: root.page-title; }
        HorizontalLayout {
            height: 44px; spacing: 4px;
            for page[i] in root.pages: PageButton { text: page.title; selected: page.id == root.page-id; implemented: page.implemented; clicked => { root.page-selected(i); } }
        }
        HorizontalLayout {
            spacing: 5px; height: 72px;
            for item[i] in root.encoders: ContextualEncoder { label: item.label; value: item.value; unit: item.unit; active: item.active; turned(delta) => { root.encoder-turned(i, delta); } }
        }
        if root.page-id == "performance": PerformancePage {
            vertical-stretch: 1; transport-state: root.transport-state;
            selected-track: root.selected-track; track-owner: root.track-owner;
            active-content: root.active-content; launch-quantization: root.launch-quantization;
            pads: root.pads; scenes: root.scenes;
            transport-invoked(action) => { root.transport-invoked(action); }
            track-selected(direction) => { root.track-selected(direction); }
            return-arrangement => { root.return-arrangement(); }
            quantization-invoked => { root.quantization-invoked(); }
            scene-invoked(index) => { root.scene-invoked(index); }
            pad-invoked(index, pressed) => { root.pad-invoked(index, pressed); }
        }
        if root.page-id == "sequencer": SequencerPage {
            vertical-stretch: 1; selected-track: root.selected-track; selected-pattern: root.selected-pattern;
            pattern-length: root.pattern-length; step-resolution: root.step-resolution; selected-velocity: root.selected-velocity;
            selected-duration: root.selected-duration; arrangement-loop: root.arrangement-loop; arrangement-view: root.arrangement-view;
            selected-pitch: root.selected-pitch; selected-probability: root.selected-probability;
            selected-condition: root.selected-condition; selected-ratchet: root.selected-ratchet;
            selected-timing: root.selected-timing; page-label: root.step-page-label;
            lock-parameter: root.step-lock-parameter; lock-value: root.step-lock-value;
            lock-available: root.step-lock-available; playhead-follow: root.playhead-follow;
            can-page-previous: root.can-page-previous; can-page-next: root.can-page-next;
            confirm-delete-track: root.confirm-delete-track; confirm-delete-pattern: root.confirm-delete-pattern;
            steps: root.steps; tracks: root.sequencer-tracks; patterns: root.patterns; arrangement-items: root.arrangement-items;
            track-selected(direction) => { root.track-selected(direction); } arrangement-toggle => { root.arrangement-toggle(); }
            resolution-invoked => { root.resolution-invoked(); } step-invoked(index) => { root.sequencer-step-invoked(index); }
            pattern-invoked(index, launch) => { root.pattern-invoked(index, launch); } pattern-create(duplicate) => { root.pattern-create(duplicate); }
            step-edit(action) => { root.step-edit(action); } arrangement-item-invoked(index) => { root.arrangement-item-invoked(index); }
            step-page(direction) => { root.step-page(direction); } playhead-follow-changed(enabled) => { root.playhead-follow-changed(enabled); }
            advanced-step-edit(property, direction) => { root.advanced-step-edit(property, direction); }
            condition-cycle => { root.condition-cycle(); } lock-parameter-cycle(direction) => { root.lock-parameter-cycle(direction); }
            lock-edit(operation, direction) => { root.lock-edit(operation, direction); }
            track-item-selected(index) => { root.track-item-selected(index); } track-manage(operation) => { root.track-manage(operation); }
            pattern-manage(operation) => { root.pattern-manage(operation); }
            text-requested(operation, current) => { root.text-entry-requested(operation, current); }
        }
        if root.page-id == "sample": SamplePage {
            vertical-stretch: 1; sample-slot: root.sample-slot; sample-name: root.sample-name; sample-status: root.sample-status;
            sample-metadata: root.sample-metadata; sample-error: root.sample-error; analysis-status: root.analysis-status;
            processing-status: root.processing-status; sample-ready: root.sample-ready; sample-stereo: root.sample-stereo;
            processing-progress: root.processing-progress; processing-can-cancel: root.processing-can-cancel;
            processing-can-publish: root.processing-can-publish; processing-audio-active: root.processing-audio-active;
            waveform-zoom: root.waveform-zoom; waveform-left: root.waveform-left; waveform-right: root.waveform-right;
            slice-markers: root.slice-markers; region-start: root.region-start; region-end: root.region-end;
            sample-slices: root.sample-slices; sample-regions: root.sample-regions;
            sample-slot-selected(direction) => { root.sample-slot-selected(direction); } browse-samples => { root.sample-browse-requested(); }
            waveform-selected(value) => { root.waveform-selected(value); } waveform-zoomed(value) => { root.waveform-zoomed(value); }
            slice-selected(index) => { root.slice-selected(index); } slice-action(action) => { root.slice-action(action); }
            region-selected(index) => { root.region-selected(index); } region-action(action) => { root.region-action(action); }
            sample-preview(target) => { root.sample-preview(target); } sample-analysis(action) => { root.sample-analysis(action); }
            sample-processing(action) => { root.sample-processing(action); }
            processing-lifecycle(action, value) => { root.processing-lifecycle(action, value); }
            text-requested(operation, current) => { root.text-entry-requested(operation, current); }
        }
        if root.page-id == "sound": SoundPage {
            vertical-stretch: 1; track: root.sound-track; instrument: root.sound-instrument; instrument-id: root.sound-instrument-id;
            instrument-available: root.sound-instrument-available; is-synth: root.sound-is-synth; is-sample: root.sound-is-sample;
            subview: root.sound-subview; parameters: root.sound-parameters; modulation: root.sound-modulation;
            selected-parameter: root.sound-selected-parameter; selected-modulation: root.sound-selected-modulation;
            sample-mode: root.sound-sample-mode; sample-envelope: root.sound-sample-envelope; sample-tuning: root.sound-sample-tuning;
            preset-status: root.sound-preset-status; error: root.sound-error; preset-library <=> root.sound-preset-library; preset-id <=> root.sound-preset-id;
            subview-selected(value) => { root.sound-subview-selected(value); } instrument-selected(value) => { root.sound-instrument-selected(value); }
            parameter-selected(index) => { root.sound-parameter-selected(index); } parameter-adjusted(index, steps) => { root.sound-parameter-adjusted(index, steps); }
            sample-action(action) => { root.sound-sample-action(action); } modulation-selected(index) => { root.sound-modulation-selected(index); }
            modulation-action(action) => { root.sound-modulation-action(action); } preset-action(action, library, id) => { root.sound-preset-action(action, library, id); }
        }
        if root.page-id == "mixer": MixerPage {
            vertical-stretch: 1; channels: root.mixer-channels; external-fx: root.mixer-external-fx;
            bank: root.mixer-bank; bank-label: root.mixer-bank-label; selected-channel: root.mixer-selected-channel; error: root.mixer-error;
            channel-selected(index) => { root.mixer-channel-selected(index); } bank-changed(direction) => { root.mixer-bank-changed(direction); }
            adjust(operation, steps) => { root.mixer-adjust(operation, steps); } toggle(operation) => { root.mixer-toggle(operation); }
            route-cycle => { root.mixer-route-cycle(); } group-cycle => { root.mixer-group-cycle(); } fx-selected(index) => { root.mixer-fx-selected(index); }
            fx-adjust(operation, steps) => { root.mixer-fx-adjust(operation, steps); } fx-toggle(operation) => { root.mixer-fx-toggle(operation); }
        }
        if root.page-id == "fx": FxPage {
            vertical-stretch: 1; subview: root.fx-subview; owner-name: root.fx-owner-name; chain-bypass: root.fx-chain-bypass; error: root.fx-error;
            owners: root.fx-owners; effects: root.fx-effects; parameters: root.fx-parameters; modulators: root.fx-modulators; routes: root.fx-routes; macros: root.fx-macros; external-fx: root.mixer-external-fx;
            subview-selected(value) => { root.fx-subview-selected(value); } owner-selected(index) => { root.fx-owner-selected(index); }
            effect-selected(index) => { root.fx-effect-selected(index); } effect-add(kind) => { root.fx-effect-add(kind); }
            effect-action(action) => { root.fx-effect-action(action); } parameter-selected(index) => { root.fx-parameter-selected(index); }
            parameter-adjusted(steps) => { root.fx-parameter-adjusted(steps); } modulator-selected(index) => { root.fx-modulator-selected(index); }
            route-selected(index) => { root.fx-route-selected(index); } route-action(action) => { root.fx-route-action(action); } route-create => { root.fx-route-create(); }
            macro-selected(index) => { root.fx-macro-selected(index); } macro-adjusted(steps) => { root.fx-macro-adjusted(steps); }
            external-selected(index) => { root.mixer-fx-selected(index); } external-adjust(operation, steps) => { root.mixer-fx-adjust(operation, steps); } external-toggle(operation) => { root.mixer-fx-toggle(operation); }
            preset-action(action) => { root.sound-preset-action(action, "", ""); }
        }
        if root.page-id == "browser": BrowserPage {
            vertical-stretch: 1; category: root.browser-category; location: root.browser-location; destination: root.browser-destination;
            preview: root.browser-preview; sort-mode: root.browser-sort; error: root.browser-error; truncated: root.browser-truncated;
            loading: root.browser-loading; page-label: root.browser-page-label;
            can-previous-page: root.browser-can-previous-page; can-next-page: root.browser-can-next-page;
            missing-assets: root.browser-missing-assets; selected-missing: root.browser-selected-missing;
            entries: root.browser-entries; filter-text: root.browser-filter;
            category-selected(value) => { root.browser-category-selected(value); } parent-requested => { root.browser-parent(); }
            entry-selected(index) => { root.browser-entry-selected(index); } entry-activated => { root.browser-activate(); }
            filter-requested(value) => { root.browser-filter-requested(value); } sort-requested => { root.browser-sort-requested(); }
            project-action(action, path) => { root.browser-project-action(action, path); } preset-action(action) => { root.browser-preset-action(action); }
            page-requested(direction) => { root.browser-page-requested(direction); } refresh-requested => { root.browser-refresh-requested(); }
            text-requested(operation, current) => { root.text-entry-requested(operation, current); }
            missing-selected(index) => { root.browser-missing-selected(index); } relink-requested(prefix) => { root.browser-relink-requested(prefix); }
        }
        if root.page-id == "setup": SetupPage {
            vertical-stretch: 1; subview: root.setup-subview; audio-backend: root.setup-audio-backend; audio-status: root.setup-audio-status;
            active-input: root.setup-active-input; active-output: root.setup-active-output; requested-input: root.setup-requested-input; requested-output: root.setup-requested-output;
            sample-rate: root.setup-sample-rate; active-buffer: root.setup-active-buffer; requested-buffer: root.setup-requested-buffer;
            active-input-channels: root.setup-active-input-channels; active-output-channels: root.setup-active-output-channels;
            requested-input-channels: root.setup-requested-input-channels; requested-output-channels: root.setup-requested-output-channels;
            restart-required: root.setup-restart-required; pending: root.setup-pending; fullscreen: root.setup-fullscreen;
            reopen-last-project: root.setup-reopen-last-project; ui-scale: root.setup-ui-scale; startup-project: root.setup-startup-project;
            midi-clock: root.setup-midi-clock; system: root.setup-system; version: root.setup-version; callback-load: root.setup-callback-load;
            callback-peak: root.setup-callback-peak; xruns: root.setup-xruns; xruns-available: root.setup-xruns-available;
            error: root.setup-error; learn-status: root.setup-learn-status; audio-inputs: root.setup-audio-inputs; audio-outputs: root.setup-audio-outputs;
            midi-inputs: root.setup-midi-inputs; midi-outputs: root.setup-midi-outputs; controllers: root.setup-controllers; midi-routes: root.setup-midi-routes; mappings: root.setup-mappings;
            learn-control <=> root.setup-learn-control; learn-mode <=> root.setup-learn-mode;
            subview-selected(value) => { root.setup-subview-selected(value); } device-selected(kind, index) => { root.setup-device-selected(kind, index); }
            value-adjusted(property, direction) => { root.setup-value-adjusted(property, direction); }
            preference-toggled(property) => { root.setup-preference-toggled(property); } preferences-action(action) => { root.setup-preferences-action(action); }
            controller-selected(index) => { root.setup-controller-selected(index); } midi-learn(action, control, mode) => { root.setup-midi-learn(action, control, mode); }
            midi-route-selected(index) => { root.setup-midi-route-selected(index); } midi-route-action(action) => { root.setup-midi-route-action(action); }
            mapping-selected(index) => { root.setup-mapping-selected(index); } mapping-remove => { root.setup-mapping-remove(); }
            text-requested(operation, current) => { root.text-entry-requested(operation, current); } exit-requested => { root.setup-exit(); }
        }
        if root.page-id != "performance" && root.page-id != "sequencer" && root.page-id != "sample" && root.page-id != "sound" && root.page-id != "mixer" && root.page-id != "fx" && root.page-id != "browser" && root.page-id != "setup": EmptyState { vertical-stretch: 1; title: root.page-title; message: "This destination is registered, but its production page is not implemented."; }
        HorizontalLayout { spacing: 5px; height: 54px; for item[i] in root.functions: ContextualFunctionButton { text: item.label; available: item.active; clicked => { root.function-invoked(i); } } }
        Notification { message: root.notification; height: 30px; dismissed => { root.notification-dismissed(); } }
    }
    if root.recording-visible: Rectangle { x: 0; y: 0; background: #aa111111;
        Rectangle { width: min(760px, parent.width - 40px); height: min(520px, parent.height - 40px); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; background: Theme.panel; border-width: 1px; border-color: Theme.accent; border-radius: Theme.radius;
            VerticalLayout { padding: 16px; spacing: 10px;
                Text { text: "Recording & Capture"; color: Theme.foreground; font-size: 22px; }
                HorizontalLayout { spacing: 4px;
                    PageButton { text: "Audio"; selected: root.recording-mode == "External audio"; clicked => { root.recording-mode-selected("audio"); } }
                    PageButton { text: "Resample"; selected: root.recording-mode == "Internal resampling"; clicked => { root.recording-mode-selected("resample"); } }
                    PageButton { text: "Live Loop"; selected: root.recording-mode == "Live loop"; clicked => { root.recording-mode-selected("live-loop"); } }
                    PageButton { text: "Arrangement"; selected: root.recording-mode == "Arrangement capture"; clicked => { root.recording-mode-selected("arrangement"); } }
                    PageButton { text: "Performance"; selected: root.recording-mode == "Performance capture"; clicked => { root.recording-mode-selected("performance"); } }
                }
                HorizontalLayout { ParameterDisplay { name: "State"; value: root.recording-phase; } ParameterDisplay { name: "Source"; value: root.recording-source; } ParameterDisplay { name: "Destination"; value: root.recording-destination; } ParameterDisplay { name: "Quantization"; value: root.recording-quantization; } }
                HorizontalLayout { spacing: 4px;
                    PageButton { text: "External stereo"; implemented: root.recording-mode == "External audio" || root.recording-mode == "Live loop"; clicked => { root.recording-source-selected("external-stereo"); } }
                    PageButton { text: "Track"; implemented: root.recording-mode != "External audio"; clicked => { root.recording-source-selected("track"); } }
                    PageButton { text: "Group"; implemented: root.recording-mode != "External audio"; clicked => { root.recording-source-selected("group-post-fader"); } }
                    PageButton { text: "Master"; implemented: root.recording-mode != "External audio"; clicked => { root.recording-source-selected("master-post"); } }
                }
                HorizontalLayout { spacing: 4px;
                    PageButton { text: "Immediate"; selected: root.recording-quantization == "immediate"; clicked => { root.recording-quantization-selected("immediate"); } }
                    PageButton { text: "Beat"; selected: root.recording-quantization == "beat"; clicked => { root.recording-quantization-selected("beat"); } }
                    PageButton { text: "Bar"; selected: root.recording-quantization == "bar"; clicked => { root.recording-quantization-selected("bar"); } }
                }
                Rectangle { height: 10px; background: Theme.muted; Rectangle { width: parent.width * max(0, min(1, root.recording-progress)); height: parent.height; background: Theme.accent; } }
                if root.recording-error != "": Text { text: root.recording-error; color: Theme.warning; wrap: word-wrap; }
                HorizontalLayout { spacing: 5px;
                    PageButton { text: "Arm"; implemented: root.recording-can-arm; clicked => { root.recording-action("arm"); } }
                    PageButton { text: "Start"; implemented: root.recording-can-start; clicked => { root.recording-action("start"); } }
                    PageButton { text: "Stop"; implemented: root.recording-can-stop; clicked => { root.recording-action("stop"); } }
                    PageButton { text: "Commit"; implemented: root.recording-can-commit; clicked => { root.recording-action("commit"); } }
                    PageButton { text: "Overdub"; implemented: root.recording-mode == "Live loop" && root.recording-phase == "Completed"; clicked => { root.recording-action("overdub"); } }
                    PageButton { text: "Replace"; implemented: root.recording-mode == "Live loop" && root.recording-phase == "Completed"; clicked => { root.recording-action("replace"); } }
                    PageButton { text: "Cancel"; implemented: root.recording-can-cancel; clicked => { root.recording-action("cancel"); } }
                    PageButton { text: "Close"; implemented: true; clicked => { root.recording-closed(); } }
                }
            }
        }
    }
    if root.modal-visible || root.browser-confirmation-pending: Rectangle { x: 0; y: 0; background: #88111111; ModalDialog { width: min(520px, parent.width - 48px); height: 210px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; title: "Confirm"; message: root.browser-confirmation-pending ? root.browser-confirmation-message : "Confirm this operation."; accepted => { if (root.browser-confirmation-pending) { root.browser-confirm(true); } root.modal-visible = false; } rejected => { if (root.browser-confirmation-pending) { root.browser-confirm(false); } root.modal-visible = false; } } }
    if root.text-entry-visible: Rectangle { x: 0; y: 0; background: #aa111111;
        TouchKeyboard { width: min(900px, parent.width - 24px); height: min(560px, parent.height - 24px); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; title: root.text-entry-title; value: root.text-entry-value; cursor-position: root.text-entry-cursor; error: root.text-entry-error; uppercase: root.text-entry-uppercase; symbols: root.text-entry-symbols; insert(value) => { root.text-entry-insert(value); } action(value) => { root.text-entry-action(value); } }
    }
}
