import { LineEdit } from "std-widgets.slint";
import { PageButton, ContextualEncoder, ContextualFunctionButton, GlobalStatus, TransportControls, TrackSelector, PerformanceSlot, EmptyState, ParameterDisplay, WaveformOverview, Notification, ModalDialog } from "components.slint";
import { Theme } from "theme.slint";

export struct ContextItem { label: string, value: string, unit: string, active: bool }
export struct PadItem { label: string, status: string, active: bool, queued: bool, selected: bool, available: bool }
export struct PageItem { id: string, title: string, implemented: bool }
export struct SceneItem { label: string, queued: bool }
export struct StepItem { label: string, status: string, active: bool, selected: bool, playhead: bool, available: bool }
export struct PatternItem { id: int, name: string, selected: bool, active: bool, queued: bool }
export struct ArrangementItem { id: int, label: string, range: string, kind: string, selected: bool, enabled: bool }
export struct SliceItem { id: int, label: string, range: string, selected: bool, assigned: bool }
export struct RegionItem { id: int, label: string, range: string, fade: string, loop: string, selected: bool }

export component PerformanceWindow inherits Window {
    title: "NEUROGENIC"; preferred-width: 1280px; preferred-height: 800px;
    min-width: 1024px; min-height: 600px; background: Theme.background;
    in property <string> project-name: "Untitled";
    in property <bool> project-dirty: false;
    in property <string> transport-state: "Stopped";
    in property <string> tempo: "120 BPM";
    in property <string> time-signature: "4/4";
    in property <string> position: "1.1.0";
    in property <string> page-id: "performance";
    in property <string> page-title: "Performance";
    in property <string> selected-track: "Unavailable";
    in property <string> track-owner: "Arrangement";
    in property <string> active-content: "Unavailable";
    in property <string> launch-quantization: "Bar";
    in property <string> notification: "";
    in property <bool> arrangement-view: false;
    in property <string> selected-pattern: "Unavailable";
    in property <string> pattern-length: "Unavailable";
    in property <string> step-resolution: "1/16";
    in property <string> selected-velocity: "--";
    in property <string> selected-duration: "--";
    in property <string> arrangement-loop: "Off";
    in property <int> sample-slot: 0;
    in property <string> sample-name: "Empty slot";
    in property <string> sample-status: "Empty";
    in property <string> sample-metadata: "Unavailable";
    in property <string> sample-error: "";
    in property <string> analysis-status: "Idle";
    in property <string> processing-status: "Idle";
    in property <bool> sample-ready: false;
    in property <bool> sample-stereo: false;
    in property <float> waveform-zoom: 1;
    in property <[float]> waveform-left;
    in property <[float]> waveform-right;
    in property <[float]> slice-markers;
    in property <float> region-start: 0;
    in property <float> region-end: 1;
    in property <[PageItem]> pages;
    in property <[ContextItem]> encoders;
    in property <[ContextItem]> functions;
    in property <[PadItem]> pads;
    in property <[SceneItem]> scenes;
    in property <[StepItem]> steps;
    in property <[PatternItem]> patterns;
    in property <[ArrangementItem]> arrangement-items;
    in property <[SliceItem]> sample-slices;
    in property <[RegionItem]> sample-regions;
    in-out property <string> sample-path: "";
    in-out property <bool> modal-visible: false;
    callback encoder-turned(int, int); callback function-invoked(int);
    callback pad-invoked(int, bool); callback keyboard-input(string, bool);
    callback page-selected(int); callback transport-invoked(string);
    callback track-selected(int); callback return-arrangement();
    callback scene-invoked(int); callback notification-dismissed();
    callback quantization-invoked();
    callback sequencer-step-invoked(int); callback pattern-invoked(int, bool);
    callback pattern-create(bool); callback resolution-invoked();
    callback arrangement-toggle(); callback arrangement-item-invoked(int);
    callback step-edit(string);
    callback sample-slot-selected(int); callback sample-load(string);
    callback waveform-selected(float); callback waveform-zoomed(float);
    callback slice-selected(int); callback slice-action(string);
    callback region-selected(int); callback region-action(string);
    callback sample-preview(string); callback sample-analysis(string);
    callback sample-processing(string);

    FocusScope { key-pressed(event) => { root.keyboard-input(event.text, true); accept } key-released(event) => { root.keyboard-input(event.text, false); accept } }
    VerticalLayout {
        padding: 8px; spacing: 6px;
        GlobalStatus { height: 48px; project: root.project-name; dirty: root.project-dirty; transport: root.transport-state; tempo: root.tempo; signature: root.time-signature; position: root.position; page-title: root.page-title; }
        HorizontalLayout {
            height: 44px; spacing: 4px;
            for page[i] in root.pages: PageButton { text: page.title; selected: page.id == root.page-id; implemented: page.implemented; clicked => { root.page-selected(i); } }
        }
        HorizontalLayout {
            spacing: 5px; height: 72px;
            for item[i] in root.encoders: ContextualEncoder { label: item.label; value: item.value; unit: item.unit; active: item.active; turned(delta) => { root.encoder-turned(i, delta); } }
        }
        if root.page-id == "performance": VerticalLayout {
            spacing: 6px; vertical-stretch: 1;
            HorizontalLayout {
                height: 58px; spacing: 6px;
                TransportControls { state: root.transport-state; play => { root.transport-invoked("play"); } stop => { root.transport-invoked("stop"); } record => { root.transport-invoked("record"); } }
                TrackSelector { horizontal-stretch: 2; track: root.selected-track; owner: root.track-owner; previous => { root.track-selected(-1); } next => { root.track-selected(1); } return-arrangement => { root.return-arrangement(); } }
                Rectangle { horizontal-stretch: 1; background: Theme.panel; border-radius: Theme.radius; VerticalLayout { padding: 6px; Text { text: root.active-content; color: Theme.foreground; overflow: elide; } Text { text: "Launch: " + root.launch-quantization; color: Theme.muted; overflow: elide; } } TouchArea { clicked => { root.quantization-invoked(); } } }
            }
            if root.scenes.length > 0: HorizontalLayout { height: 38px; spacing: 5px; for scene[i] in root.scenes: PageButton { text: scene.label + (scene.queued ? " (Queued)" : ""); implemented: true; clicked => { root.scene-invoked(i); } } }
            Rectangle {
                background: Theme.panel; border-radius: Theme.radius; vertical-stretch: 1;
                GridLayout { padding: 8px; spacing: 6px; for pad[i] in root.pads: PerformanceSlot { row: i / 8; col: mod(i, 8); label: pad.label; state: pad.status; selected: pad.selected; available: pad.available; invoked => { root.pad-invoked(i, true); } } }
            }
        }
        if root.page-id == "sequencer": VerticalLayout {
            spacing: 6px; vertical-stretch: 1;
            HorizontalLayout {
                height: 44px; spacing: 5px;
                PageButton { text: "Steps"; selected: !root.arrangement-view; implemented: true; clicked => { if (root.arrangement-view) { root.arrangement-toggle(); } } }
                PageButton { text: "Arrangement"; selected: root.arrangement-view; implemented: true; clicked => { if (!root.arrangement-view) { root.arrangement-toggle(); } } }
                PageButton { text: root.selected-track; implemented: true; clicked => { root.track-selected(1); } }
                PageButton { text: root.selected-pattern; implemented: true; clicked => { } }
                PageButton { text: root.pattern-length; implemented: false; clicked => { } }
                PageButton { text: root.step-resolution; implemented: true; clicked => { root.resolution-invoked(); } }
            }
            if !root.arrangement-view: HorizontalLayout {
                spacing: 6px; vertical-stretch: 1;
                Rectangle {
                    background: Theme.panel; border-radius: Theme.radius; horizontal-stretch: 4;
                    GridLayout { padding: 8px; spacing: 6px; for step[i] in root.steps: PerformanceSlot { row: i / 8; col: mod(i, 8); label: step.label + (step.playhead ? " >" : ""); state: step.status; selected: step.selected; available: step.available; invoked => { root.sequencer-step-invoked(i); } } }
                }
                VerticalLayout {
                    spacing: 5px; horizontal-stretch: 2;
                    Rectangle { background: Theme.panel; border-radius: Theme.radius; vertical-stretch: 2; VerticalLayout { padding: 5px; spacing: 4px; Text { text: "Patterns"; color: Theme.accent; } for pattern[i] in root.patterns: PageButton { height: 32px; text: pattern.name + (pattern.queued ? " [Q]" : pattern.active ? " [A]" : ""); selected: pattern.selected; implemented: true; clicked => { root.pattern-invoked(i, false); } } } }
                    HorizontalLayout { height: 36px; spacing: 4px; PageButton { text: "New"; implemented: true; clicked => { root.pattern-create(false); } } PageButton { text: "Duplicate"; implemented: true; clicked => { root.pattern-create(true); } } }
                    ParameterDisplay { height: 34px; name: "Velocity"; value: root.selected-velocity; }
                    ParameterDisplay { height: 34px; name: "Length"; value: root.selected-duration; }
                    HorizontalLayout { height: 34px; spacing: 4px; PageButton { text: "Vel -"; implemented: true; clicked => { root.step-edit("velocity-down"); } } PageButton { text: "Vel +"; implemented: true; clicked => { root.step-edit("velocity-up"); } } PageButton { text: "Length +"; implemented: true; clicked => { root.step-edit("length-up"); } } }
                }
            }
            if root.arrangement-view: VerticalLayout {
                spacing: 5px;
                Rectangle { height: 36px; background: Theme.panel; Text { text: "Loop: " + root.arrangement-loop; color: Theme.foreground; vertical-alignment: center; } }
                if root.arrangement-items.length == 0: EmptyState { title: "Arrangement"; message: "No pattern or audio clips are placed in the arrangement."; }
                for clip[i] in root.arrangement-items: PageButton { height: 38px; text: clip.kind + "  " + clip.label + "  " + clip.range; selected: clip.selected; implemented: clip.enabled; clicked => { root.arrangement-item-invoked(i); } }
            }
        }
        if root.page-id == "sample": VerticalLayout {
            spacing: 6px; vertical-stretch: 1;
            HorizontalLayout {
                height: 42px; spacing: 5px;
                PageButton { text: "<"; implemented: true; clicked => { root.sample-slot-selected(-1); } }
                PageButton { text: "Slot " + root.sample-slot + ": " + root.sample-name; implemented: true; clicked => { } }
                PageButton { text: root.sample-status; implemented: root.sample-ready; clicked => { } }
                LineEdit { horizontal-stretch: 3; text <=> root.sample-path; placeholder-text: "/path/to/sample.wav"; }
                PageButton { text: "Load / Replace"; implemented: root.sample-path != ""; clicked => { root.sample-load(root.sample-path); } }
                PageButton { text: ">"; implemented: true; clicked => { root.sample-slot-selected(1); } }
            }
            WaveformOverview {
                vertical-stretch: 3; left-peaks: root.waveform-left; right-peaks: root.waveform-right;
                markers: root.slice-markers; stereo: root.sample-stereo; zoom: root.waveform-zoom;
                region-start: root.region-start; region-end: root.region-end;
                position-selected(value) => { root.waveform-selected(value); }
                zoom-requested(value) => { root.waveform-zoomed(value); }
            }
            HorizontalLayout {
                height: 34px; spacing: 5px;
                ParameterDisplay { name: "Format"; value: root.sample-metadata; horizontal-stretch: 3; }
                ParameterDisplay { name: "Analysis"; value: root.analysis-status; }
                ParameterDisplay { name: "Processing"; value: root.processing-status; }
                PageButton { text: "Zoom -"; implemented: root.waveform-zoom > 1; clicked => { root.waveform-zoomed(root.waveform-zoom / 2); } }
                PageButton { text: "Zoom +"; implemented: root.sample-ready; clicked => { root.waveform-zoomed(root.waveform-zoom * 2); } }
                if root.sample-error != "": ParameterDisplay { name: "Error"; value: root.sample-error; }
            }
            HorizontalLayout {
                spacing: 6px; vertical-stretch: 2;
                Rectangle { background: Theme.panel; border-radius: Theme.radius; horizontal-stretch: 2; VerticalLayout { padding: 5px; spacing: 3px; Text { text: "Slices"; color: Theme.accent; } for slice[i] in root.sample-slices: PageButton { height: 30px; text: slice.label + " " + slice.range + (slice.assigned ? " [PAD]" : ""); selected: slice.selected; implemented: true; clicked => { root.slice-selected(i); } } } }
                Rectangle { background: Theme.panel; border-radius: Theme.radius; horizontal-stretch: 2; VerticalLayout { padding: 5px; spacing: 3px; Text { text: "Regions"; color: Theme.accent; } for region[i] in root.sample-regions: PageButton { height: 30px; text: region.label + " " + region.range + " L:" + region.loop; selected: region.selected; implemented: true; clicked => { root.region-selected(i); } } } }
                VerticalLayout { spacing: 4px; horizontal-stretch: 2;
                    HorizontalLayout { PageButton { text: "Preview Sample"; implemented: root.sample-ready; clicked => { root.sample-preview("sample"); } } PageButton { text: "Preview Slice"; implemented: root.sample-slices.length > 0; clicked => { root.sample-preview("slice"); } } PageButton { text: "Stop"; implemented: true; clicked => { root.sample-preview("stop"); } } }
                    HorizontalLayout { PageButton { text: "Delete Slice"; implemented: root.sample-slices.length > 0; clicked => { root.slice-action("delete"); } } PageButton { text: "Assign Pad"; implemented: root.sample-slices.length > 0; clicked => { root.slice-action("assign"); } } PageButton { text: "Loop"; implemented: root.sample-regions.length > 0; clicked => { root.region-action("loop"); } } }
                    HorizontalLayout { PageButton { text: "Start -"; implemented: root.sample-regions.length > 0; clicked => { root.region-action("start-down"); } } PageButton { text: "Start +"; implemented: root.sample-regions.length > 0; clicked => { root.region-action("start-up"); } } PageButton { text: "End -"; implemented: root.sample-regions.length > 0; clicked => { root.region-action("end-down"); } } PageButton { text: "End +"; implemented: root.sample-regions.length > 0; clicked => { root.region-action("end-up"); } } }
                    HorizontalLayout { PageButton { text: "Fade In +"; implemented: root.sample-regions.length > 0; clicked => { root.region-action("fade-in"); } } PageButton { text: "Fade Out +"; implemented: root.sample-regions.length > 0; clicked => { root.region-action("fade-out"); } } }
                    HorizontalLayout { PageButton { text: "Detect"; implemented: root.sample-ready; clicked => { root.sample-analysis("start"); } } PageButton { text: "Accept"; implemented: root.analysis-status == "completed"; clicked => { root.sample-analysis("accept"); } } PageButton { text: "Reject"; implemented: root.analysis-status != "Idle"; clicked => { root.sample-analysis("reject"); } } }
                    HorizontalLayout { PageButton { text: "Normalize"; implemented: root.sample-ready; clicked => { root.sample-processing("normalize-peak"); } } PageButton { text: "Reverse"; implemented: root.sample-ready; clicked => { root.sample-processing("reverse"); } } PageButton { text: "Trim"; implemented: root.sample-regions.length > 0; clicked => { root.sample-processing("trim"); } } }
                }
            }
        }
        if root.page-id != "performance" && root.page-id != "sequencer" && root.page-id != "sample": EmptyState { vertical-stretch: 1; title: root.page-title; message: "This destination is registered, but its production page is not implemented."; }
        HorizontalLayout { spacing: 5px; height: 54px; for item[i] in root.functions: ContextualFunctionButton { text: item.label; available: item.active; clicked => { root.function-invoked(i); } } }
        Notification { message: root.notification; height: 30px; dismissed => { root.notification-dismissed(); } }
    }
    if root.modal-visible: Rectangle { x: 0; y: 0; background: #88111111; ModalDialog { width: min(520px, parent.width - 48px); height: 210px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; title: "Confirm"; message: "Confirm this operation."; accepted => { root.modal-visible = false; } rejected => { root.modal-visible = false; } } }
}
