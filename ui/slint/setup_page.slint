import { PageButton, EmptyState, ParameterDisplay } from "components.slint";
import { Theme } from "theme.slint";
import { ScrollView, LineEdit } from "std-widgets.slint";

export struct SetupDeviceItem { name: string, detail: string, selected: bool, available: bool }
export struct SetupControllerItem { id: string, transport: string, device: string, profile: string, protocol: string, status: string, error: string, learn-status: string, connected: bool, feedback: bool, selected: bool }
export struct SetupMidiRouteItem { id: int, input: string, output: string, channels: string, flags: string, enabled: bool, selected: bool }
export struct SetupMappingItem { endpoint: string, control: string, source: string, mode: string, target: string, feedback: bool, pickup: bool, invert: bool, fine-scale: float, acceleration: float, selected: bool }
export struct SetupMappingTargetItem { kind: string, id: string, label: string, selected: bool }

export component SetupPage inherits Rectangle {
    background: Theme.background;
    in property <string> subview: "audio";
    in property <string> audio-backend: "Unavailable"; in property <string> audio-status: "Unavailable";
    in property <string> active-input: "Unavailable"; in property <string> active-output: "Unavailable";
    in property <string> requested-input; in property <string> requested-output;
    in property <int> sample-rate: 48000; in property <int> active-buffer: 0; in property <int> requested-buffer: 256;
    in property <int> active-input-channels: 0; in property <int> active-output-channels: 0;
    in property <int> requested-input-channels: 2; in property <int> requested-output-channels: 2;
    in property <bool> restart-required: false; in property <bool> pending: false;
    in property <bool> fullscreen: false; in property <bool> reopen-last-project: false;
    in property <float> ui-scale: 1; in property <string> startup-project;
    in property <string> midi-clock: "Internal";
    in property <string> system: "Unknown"; in property <string> version: "Unknown";
    in property <float> callback-load: 0; in property <float> callback-peak: 0;
    in property <int> xruns: 0; in property <bool> xruns-available: false;
    in property <string> error; in property <string> learn-status: "Idle";
    in property <bool> conflict-visible: false;
    in property <string> conflict-existing-source; in property <string> conflict-existing-target;
    in property <string> conflict-proposed-source; in property <string> conflict-proposed-target;
    in property <string> conflict-reason;
    in property <[SetupDeviceItem]> audio-inputs; in property <[SetupDeviceItem]> audio-outputs;
    in property <[SetupDeviceItem]> midi-inputs; in property <[SetupDeviceItem]> midi-outputs;
    in property <[SetupControllerItem]> controllers;
    in property <[SetupMidiRouteItem]> midi-routes;
    in property <[SetupMappingItem]> mappings;
    in property <[SetupMappingTargetItem]> mapping-targets;
    in-out property <string> learn-control: "encoder.1"; in-out property <string> learn-mode: "cc-absolute";
    in-out property <string> manual-port: "1"; in-out property <string> manual-channel: "1";
    in-out property <string> manual-number: "0"; in-out property <string> manual-control: "encoder.1";
    in-out property <string> manual-mode: "cc-absolute"; in-out property <bool> manual-feedback: false;
    in-out property <string> mapping-argument-1-value; in-out property <string> mapping-argument-2-value;
    in-out property <string> mapping-argument-3-value; in-out property <string> mapping-argument-4-value;
    in property <string> mapping-argument-1-hint; in property <string> mapping-argument-2-hint;
    in property <string> mapping-argument-3-hint; in property <string> mapping-argument-4-hint;
    callback subview-selected(string); callback device-selected(string, int);
    callback value-adjusted(string, int); callback preference-toggled(string);
    callback preferences-action(string); callback controller-selected(int);
    callback midi-learn(string, string, string); callback text-requested(string, string); callback exit-requested();
    callback midi-route-selected(int); callback midi-route-action(string);
    callback mapping-selected(int); callback mapping-remove();
    callback mapping-target-selected(int); callback mapping-target-apply(string, string, string, string);
    callback mapping-source-apply(int, int, int, string, string, bool, bool);
    callback mapping-behavior-apply(bool, bool, float, float);
    callback mapping-conflict-action(string);

    VerticalLayout { padding: 6px; spacing: 5px;
        HorizontalLayout { height: 40px; spacing: 4px;
            PageButton { text: "Audio"; selected: root.subview == "audio"; clicked => { root.subview-selected("audio"); } }
            PageButton { text: "MIDI"; selected: root.subview == "midi"; clicked => { root.subview-selected("midi"); } }
            PageButton { text: "Controllers"; selected: root.subview == "controllers"; clicked => { root.subview-selected("controllers"); } }
            PageButton { text: "Preferences"; selected: root.subview == "preferences"; clicked => { root.subview-selected("preferences"); } }
            PageButton { text: "Diagnostics"; selected: root.subview == "diagnostics"; clicked => { root.subview-selected("diagnostics"); } }
            PageButton { text: "System"; selected: root.subview == "system"; clicked => { root.subview-selected("system"); } }
        }
        if root.restart-required: Rectangle { height: 34px; background: #6c4c18; border-radius: Theme.radius;
            Text { x: 8px; vertical-alignment: center; text: "Restart required to activate staged audio configuration"; color: Theme.foreground; }
        }
        if root.subview == "audio": HorizontalLayout { vertical-stretch: 1; spacing: 6px;
            Rectangle { horizontal-stretch: 1; background: Theme.panel; border-radius: Theme.radius;
                ScrollView { VerticalLayout { padding: 6px; spacing: 4px;
                    Text { text: "Output devices"; color: Theme.foreground; font-size: 18px; }
                    for item[i] in root.audio-outputs: PageButton { text: item.name + " — " + item.detail; selected: item.selected; implemented: item.available; clicked => { root.device-selected("audio-output", i); } }
                    Text { text: "Input devices"; color: Theme.foreground; font-size: 18px; }
                    for item[i] in root.audio-inputs: PageButton { text: item.name + " — " + item.detail; selected: item.selected; implemented: item.available; clicked => { root.device-selected("audio-input", i); } }
                } }
            }
            Rectangle { horizontal-stretch: 1; background: Theme.panel; border-radius: Theme.radius;
                VerticalLayout { padding: 6px; spacing: 4px;
                    ParameterDisplay { name: "Backend / status"; value: root.audio-backend + " / " + root.audio-status; }
                    ParameterDisplay { name: "Actual rate"; value: root.sample-rate + " Hz (fixed)"; }
                    ParameterDisplay { name: "Active output"; value: root.active-output; }
                    ParameterDisplay { name: "Requested output"; value: root.requested-output == "" ? "Backend default" : root.requested-output; }
                    ParameterDisplay { name: "Buffer active / requested"; value: root.active-buffer + " / " + root.requested-buffer; }
                    HorizontalLayout { PageButton { text: "Buffer −"; clicked => { root.value-adjusted("buffer", -1); } } PageButton { text: "Buffer +"; clicked => { root.value-adjusted("buffer", 1); } } }
                    ParameterDisplay { name: "Input channels active / requested"; value: root.active-input-channels + " / " + root.requested-input-channels; }
                    ParameterDisplay { name: "Output channels active / requested"; value: root.active-output-channels + " / " + root.requested-output-channels; }
                }
            }
        }
        if root.subview == "midi": HorizontalLayout { vertical-stretch: 1; spacing: 6px;
            Rectangle { horizontal-stretch: 1; background: Theme.panel; ScrollView { VerticalLayout { padding: 6px; spacing: 4px;
                Text { text: "MIDI inputs"; color: Theme.foreground; font-size: 18px; }
                for item[i] in root.midi-inputs: PageButton { text: item.name + " — " + item.detail; selected: item.selected; implemented: item.available; clicked => { root.device-selected("midi-input", i); } }
                Text { text: "MIDI outputs"; color: Theme.foreground; font-size: 18px; }
                for item[i] in root.midi-outputs: PageButton { text: item.name + " — " + item.detail; selected: item.selected; implemented: item.available; clicked => { root.device-selected("midi-output", i); } }
            } } }
            Rectangle { horizontal-stretch: 1; background: Theme.panel; VerticalLayout { padding: 6px; spacing: 5px;
                ParameterDisplay { name: "Clock source"; value: root.midi-clock; }
                PageButton { text: "Toggle Internal / External"; clicked => { root.value-adjusted("midi-clock", 1); } }
                Text { text: "Musical routes"; color: Theme.foreground; font-size: 18px; }
                ScrollView { vertical-stretch: 1; VerticalLayout { spacing: 3px;
                    for route[i] in root.midi-routes: PageButton {
                        text: "#" + route.id + "  " + route.input + " → " + route.output + "  " + route.channels + "  " + route.flags;
                        selected: route.selected; implemented: route.enabled;
                        clicked => { root.midi-route-selected(i); }
                    }
                } }
                HorizontalLayout { PageButton { text: "Add route"; clicked => { root.midi-route-action("add"); } } PageButton { text: "Enable"; implemented: root.midi-routes.length > 0; clicked => { root.midi-route-action("toggle-enabled"); } } PageButton { text: "Delete"; implemented: root.midi-routes.length > 0; clicked => { root.midi-route-action("delete"); } } }
                HorizontalLayout { PageButton { text: "Notes"; implemented: root.midi-routes.length > 0; clicked => { root.midi-route-action("toggle-notes"); } } PageButton { text: "CC"; implemented: root.midi-routes.length > 0; clicked => { root.midi-route-action("toggle-cc"); } } PageButton { text: "Clock"; implemented: root.midi-routes.length > 0; clicked => { root.midi-route-action("toggle-clock"); } } PageButton { text: "Transport"; implemented: root.midi-routes.length > 0; clicked => { root.midi-route-action("toggle-transport"); } } }
                Text { text: "Musical routing remains separate from controller mappings."; color: Theme.muted; wrap: word-wrap; }
            } }
        }
        if root.subview == "controllers": HorizontalLayout { vertical-stretch: 1; spacing: 6px;
            Rectangle { horizontal-stretch: 1; background: Theme.panel; ScrollView { VerticalLayout { padding: 6px; spacing: 4px;
                for item[i] in root.controllers: PageButton { text: item.id + " — " + item.device + " (" + item.status + ")"; selected: item.selected; clicked => { root.controller-selected(i); } }
                if root.controllers.length == 0: EmptyState { title: "No configured controllers"; message: "Configure endpoints at startup; unknown devices are never attached automatically."; }
            } } }
            Rectangle { horizontal-stretch: 1; background: Theme.panel; VerticalLayout { padding: 6px; spacing: 4px;
                ParameterDisplay { name: "MIDI learn"; value: root.learn-status; }
                LineEdit { text <=> root.learn-control; placeholder-text: "Logical control ID"; }
                LineEdit { text <=> root.learn-mode; placeholder-text: "cc-absolute / relative / note"; }
                HorizontalLayout { PageButton { text: "Start Learn"; implemented: root.controllers.length > 0; clicked => { root.midi-learn("start", root.learn-control, root.learn-mode); } } PageButton { text: "Confirm"; implemented: root.learn-status == "Learned — confirm mapping"; clicked => { root.midi-learn("confirm", "", ""); } } PageButton { text: "Cancel"; clicked => { root.midi-learn("cancel", "", ""); } } }
                Text { text: "Manual source"; color: Theme.foreground; font-size: 18px; }
                HorizontalLayout {
                    LineEdit { text <=> root.manual-port; placeholder-text: "Port"; }
                    LineEdit { text <=> root.manual-channel; placeholder-text: "Channel 1–16"; }
                    LineEdit { text <=> root.manual-number; placeholder-text: "Note / CC"; }
                }
                LineEdit { text <=> root.manual-control; placeholder-text: "Stable logical control ID"; }
                LineEdit { text <=> root.manual-mode; placeholder-text: "cc-absolute / cc-relative-2c / cc-relative-offset / note"; }
                HorizontalLayout {
                    PageButton { text: root.manual-feedback ? "Feedback On" : "Feedback Off"; clicked => { root.manual-feedback = !root.manual-feedback; } }
                    PageButton { text: "Validate + Add"; implemented: root.controllers.length > 0; clicked => {
                        root.mapping-source-apply(root.manual-port.to-float(), root.manual-channel.to-float() - 1,
                            root.manual-number.to-float(), root.manual-mode, root.manual-control,
                            root.manual-feedback, false);
                    } }
                    PageButton { text: "Replace Conflict"; implemented: root.controllers.length > 0; clicked => {
                        root.mapping-source-apply(root.manual-port.to-float(), root.manual-channel.to-float() - 1,
                            root.manual-number.to-float(), root.manual-mode, root.manual-control,
                            root.manual-feedback, true);
                    } }
                }
                Text { text: "Mappings"; color: Theme.foreground; font-size: 18px; }
                ScrollView { vertical-stretch: 1; VerticalLayout { spacing: 3px;
                    for mapping[i] in root.mappings: PageButton { text: mapping.control + " ← " + mapping.source + " → " + mapping.target + " (" + mapping.mode + ")"; selected: mapping.selected; clicked => { root.mapping-selected(i); } }
                } }
                Text { text: "Compatible semantic targets"; color: Theme.foreground; }
                ScrollView { height: 100px; VerticalLayout { spacing: 2px;
                    for target[i] in root.mapping-targets: PageButton { text: target.label + " (" + target.kind + ")"; selected: target.selected; clicked => { root.mapping-target-selected(i); } }
                } }
                LineEdit { text <=> root.mapping-argument-1-value; placeholder-text: root.mapping-argument-1-hint; }
                LineEdit { text <=> root.mapping-argument-2-value; placeholder-text: root.mapping-argument-2-hint; }
                LineEdit { text <=> root.mapping-argument-3-value; placeholder-text: root.mapping-argument-3-hint; }
                LineEdit { text <=> root.mapping-argument-4-value; placeholder-text: root.mapping-argument-4-hint; }
                PageButton { text: "Apply selected target"; implemented: root.mappings.length > 0 && root.mapping-targets.length > 0; clicked => { root.mapping-target-apply(root.mapping-argument-1-value, root.mapping-argument-2-value, root.mapping-argument-3-value, root.mapping-argument-4-value); } }
                for mapping[i] in root.mappings: HorizontalLayout { visible: mapping.selected; height: mapping.selected ? 34px : 0px;
                    PageButton { text: mapping.pickup ? "Pickup On" : "Pickup Off"; clicked => { root.mapping-behavior-apply(!mapping.pickup, mapping.invert, mapping.fine-scale, mapping.acceleration); } }
                    PageButton { text: mapping.invert ? "Inverted" : "Normal"; clicked => { root.mapping-behavior-apply(mapping.pickup, !mapping.invert, mapping.fine-scale, mapping.acceleration); } }
                    PageButton { text: "Fine −"; clicked => { root.mapping-behavior-apply(mapping.pickup, mapping.invert, max(0.01, mapping.fine-scale - 0.01), mapping.acceleration); } }
                    PageButton { text: "Fine +"; clicked => { root.mapping-behavior-apply(mapping.pickup, mapping.invert, min(1, mapping.fine-scale + 0.01), mapping.acceleration); } }
                    PageButton { text: "Accel −"; clicked => { root.mapping-behavior-apply(mapping.pickup, mapping.invert, mapping.fine-scale, max(0, mapping.acceleration - 0.25)); } }
                    PageButton { text: "Accel +"; clicked => { root.mapping-behavior-apply(mapping.pickup, mapping.invert, mapping.fine-scale, min(8, mapping.acceleration + 0.25)); } }
                }
                PageButton { text: "Remove selected mapping"; implemented: root.mappings.length > 0; clicked => { root.mapping-remove(); } }
                PageButton { text: "Save Profile As…"; implemented: root.controllers.length > 0; clicked => { root.text-requested("profile-save", "controller.ngc"); } }
                if root.conflict-visible: Rectangle { height: 150px; background: #553820; border-radius: Theme.radius;
                    VerticalLayout { padding: 6px; spacing: 3px;
                        Text { text: "Mapping conflict"; color: Theme.accent; font-size: 18px; }
                        Text { text: "Existing: " + root.conflict-existing-source + " → " + root.conflict-existing-target; color: Theme.foreground; wrap: word-wrap; }
                        Text { text: "Proposed: " + root.conflict-proposed-source + " → " + root.conflict-proposed-target; color: Theme.foreground; wrap: word-wrap; }
                        Text { text: root.conflict-reason; color: Theme.muted; wrap: word-wrap; }
                        HorizontalLayout { PageButton { text: "Replace"; clicked => { root.mapping-conflict-action("replace"); } } PageButton { text: "Cancel"; clicked => { root.mapping-conflict-action("cancel"); } } }
                    }
                }
                Text { text: "Manual and learned sources share validation. Targets come from application discovery; replacement is explicit and atomic."; color: Theme.muted; wrap: word-wrap; }
            } }
        }
        if root.subview == "preferences": Rectangle { vertical-stretch: 1; background: Theme.panel; VerticalLayout { padding: 8px; spacing: 5px;
            ParameterDisplay { name: "Reopen last project"; value: root.reopen-last-project ? "On" : "Off"; }
            PageButton { text: "Toggle reopen last project"; clicked => { root.preference-toggled("reopen-last-project"); } }
            ParameterDisplay { name: "Fullscreen on restart"; value: root.fullscreen ? "On" : "Off"; }
            PageButton { text: "Toggle fullscreen"; clicked => { root.preference-toggled("fullscreen"); } }
            ParameterDisplay { name: "UI scale"; value: root.ui-scale; }
            HorizontalLayout { PageButton { text: "Scale −"; clicked => { root.value-adjusted("ui-scale", -1); } } PageButton { text: "Scale +"; clicked => { root.value-adjusted("ui-scale", 1); } } }
            ParameterDisplay { name: "Startup project"; value: root.startup-project == "" ? "None" : root.startup-project; }
            HorizontalLayout { PageButton { text: "Save"; implemented: root.pending; clicked => { root.preferences-action("save"); } } PageButton { text: "Revert"; implemented: root.pending; clicked => { root.preferences-action("revert"); } } }
        } }
        if root.subview == "diagnostics": Rectangle { vertical-stretch: 1; background: Theme.panel; VerticalLayout { padding: 8px; spacing: 5px;
            ParameterDisplay { name: "Audio callback average"; value: root.callback-load + "%"; }
            ParameterDisplay { name: "Audio callback peak"; value: root.callback-peak + "%"; }
            ParameterDisplay { name: "Backend XRUNs"; value: root.xruns-available ? root.xruns : "Unavailable"; }
            Text { text: "Values are bounded production instrumentation, not an additional profiler."; color: Theme.muted; wrap: word-wrap; }
        } }
        if root.subview == "system": Rectangle { vertical-stretch: 1; background: Theme.panel; VerticalLayout { padding: 8px; spacing: 5px;
            ParameterDisplay { name: "NEUROGENIC"; value: root.version; }
            ParameterDisplay { name: "System"; value: root.system; }
            PageButton { text: "Graceful Exit"; clicked => { root.exit-requested(); } }
            Text { text: "System shutdown, updates, firmware flashing, and privileged commands are unavailable by design."; color: Theme.muted; wrap: word-wrap; }
        } }
        Text { height: 24px; text: root.error; color: #ff8080; wrap: word-wrap; }
    }
}
