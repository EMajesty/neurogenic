import { PageButton, TransportControls, TrackSelector, PerformanceSlot } from "components.slint";
import { Theme } from "theme.slint";
import { ScrollView, LineEdit } from "std-widgets.slint";
import { SetupArgumentItem } from "setup_page.slint";

export struct PadItem { label: string, status: string, active: bool, queued: bool, selected: bool, available: bool }
export struct SceneItem { label: string, queued: bool }
export struct PerformanceBankItem { id: int, name: string, selected: bool }
export struct PerformanceAssignmentTargetItem { kind: string, id: string, label: string, category: string, selected: bool, available: bool }
export struct PerformancePositionItem { position: int, label: string, category: string, secondary: bool, action: bool, pad: bool, assigned: bool, selected: bool }

export component PerformancePage inherits VerticalLayout {
    in property <string> transport-state;
    in property <string> selected-track;
    in property <string> track-owner;
    in property <string> active-content;
    in property <string> launch-quantization;
    in property <[PadItem]> pads;
    in property <[SceneItem]> scenes;
    in property <[PerformanceBankItem]> banks;
    in property <string> bank-name;
    in property <[PerformanceAssignmentTargetItem]> assignment-targets;
    in property <[PerformancePositionItem]> assignment-positions;
    in property <bool> assignment-editor-visible: false;
    in-out property <string> assignment-label;
    in-out property <string> assignment-behavior: "one-shot";
    in property <[SetupArgumentItem]> arguments;
    in-out property <string> argument-value;
    callback transport-invoked(string); callback track-selected(int);
    callback return-arrangement(); callback quantization-invoked();
    callback scene-invoked(int); callback pad-invoked(int, bool);
    callback bank-selected(int); callback bank-action(string);
    callback assignment-open(int, bool, bool); callback assignment-target-selected(int);
    callback argument-selected(int); callback argument-value-changed(string);
    callback assignment-confirm(string, string);
    callback assignment-cancel();
    callback assignment-clear(); callback pad-assignment-edit(int);
    spacing: 6px;
    HorizontalLayout {
        height: 38px; spacing: 5px;
        Text { text: "Bank: " + root.bank-name; color: Theme.accent; vertical-alignment: center; }
        PageButton { text: "<"; implemented: root.banks.length > 0; clicked => { root.bank-action("previous"); } }
        PageButton { text: ">"; implemented: root.banks.length > 0; clicked => { root.bank-action("next"); } }
        for bank[i] in root.banks: PageButton { text: bank.name; selected: bank.selected; clicked => { root.bank-selected(i); } }
        PageButton { text: "+ Bank"; clicked => { root.bank-action("create"); } }
        PageButton { text: "Duplicate"; implemented: root.banks.length > 0; clicked => { root.bank-action("duplicate"); } }
        PageButton { text: "Delete"; implemented: root.banks.length > 0; clicked => { root.bank-action("delete"); } }
        Text { text: "48 logical positions"; color: Theme.muted; vertical-alignment: center; }
    }
    HorizontalLayout {
        height: 58px; spacing: 6px;
        TransportControls { state: root.transport-state; play => { root.transport-invoked("play"); } stop => { root.transport-invoked("stop"); } record => { root.transport-invoked("record"); } }
        TrackSelector { horizontal-stretch: 2; track: root.selected-track; owner: root.track-owner; previous => { root.track-selected(-1); } next => { root.track-selected(1); } return-arrangement => { root.return-arrangement(); } }
        Rectangle { horizontal-stretch: 1; background: Theme.panel; border-radius: Theme.radius; VerticalLayout { padding: 6px; Text { text: root.active-content; color: Theme.foreground; overflow: elide; } Text { text: "Launch: " + root.launch-quantization; color: Theme.muted; overflow: elide; } } TouchArea { clicked => { root.quantization-invoked(); } } }
    }
    if root.scenes.length > 0: HorizontalLayout { height: 38px; spacing: 5px; for scene[i] in root.scenes: PageButton { text: scene.label + (scene.queued ? " (Queued)" : ""); implemented: true; clicked => { root.scene-invoked(i); } } }
    Rectangle { background: Theme.panel; border-radius: Theme.radius; vertical-stretch: 1; GridLayout { padding: 8px; spacing: 6px; for pad[i] in root.pads: PerformanceSlot { row: i / 8; col: mod(i, 8); label: pad.label; state: pad.status; selected: pad.selected; available: pad.available; invoked => { root.pad-invoked(i, true); } } } }
    ScrollView { height: 112px; HorizontalLayout { spacing: 3px;
        for position[i] in root.assignment-positions: PageButton {
            text: position.label + (position.assigned ? " *" : "");
            selected: position.selected; implemented: root.banks.length > 0;
            clicked => {
                if position.pad { root.pad-assignment-edit(position.position); }
                else { root.assignment-open(position.position, position.secondary, position.action); }
            }
        }
    } }
    if root.assignment-editor-visible: Rectangle {
        height: 230px; background: Theme.panel; border-radius: Theme.radius;
        HorizontalLayout { padding: 6px; spacing: 6px;
            ScrollView { horizontal-stretch: 1; VerticalLayout { spacing: 2px;
                for target[i] in root.assignment-targets: PageButton { text: target.category + " — " + target.label; selected: target.selected; implemented: target.available; clicked => { root.assignment-target-selected(i); } }
            } }
            VerticalLayout { horizontal-stretch: 1; spacing: 4px;
                LineEdit { text <=> root.assignment-label; placeholder-text: "Optional user label"; }
                LineEdit { text <=> root.assignment-behavior; placeholder-text: "one-shot / toggle / momentary"; }
                ScrollView { height: min(100px, root.arguments.length * 30px); VerticalLayout { spacing: 2px;
                    for argument[i] in root.arguments: PageButton { text: argument.label + (argument.required ? " *" : ""); selected: argument.selected; clicked => { root.argument-selected(i); } }
                } }
                LineEdit { text <=> root.argument-value; placeholder-text: root.arguments.length > 0 ? root.arguments[0].hint : "No typed arguments"; }
                HorizontalLayout {
                    PageButton { text: "Validate + Confirm"; implemented: root.assignment-targets.length > 0; clicked => { root.argument-value-changed(root.argument-value); root.assignment-confirm(root.assignment-label, root.assignment-behavior); } }
                    PageButton { text: "Clear"; clicked => { root.assignment-clear(); } }
                    PageButton { text: "Cancel"; clicked => { root.assignment-cancel(); } }
                }
            }
        }
    }
}
