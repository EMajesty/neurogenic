import { PageButton, PerformanceSlot, EmptyState, ParameterDisplay } from "components.slint";
import { Theme } from "theme.slint";

export struct StepItem { label: string, status: string, active: bool, selected: bool, playhead: bool, available: bool }
export struct PatternItem { id: int, name: string, selected: bool, active: bool, queued: bool }
export struct ArrangementItem { id: int, label: string, range: string, kind: string, selected: bool, enabled: bool }
export struct TrackItem { id: int, name: string, instrument: string, selected: bool, muted: bool, solo: bool, record-armed: bool, effectively-audible: bool }

export component SequencerPage inherits VerticalLayout {
    in property <string> selected-track; in property <string> selected-pattern;
    in property <string> pattern-length; in property <string> step-resolution;
    in property <string> selected-velocity; in property <string> selected-duration;
    in property <string> selected-pitch; in property <string> selected-probability;
    in property <string> selected-condition; in property <string> selected-ratchet;
    in property <string> selected-timing; in property <string> page-label;
    in property <string> lock-parameter; in property <string> lock-value;
    in property <bool> lock-available; in property <bool> playhead-follow;
    in property <bool> can-page-previous; in property <bool> can-page-next;
    in property <bool> confirm-delete-track; in property <bool> confirm-delete-pattern;
    in property <bool> confirm-delete-clip;
    in property <string> arrangement-loop; in property <bool> arrangement-view;
    in property <[StepItem]> steps; in property <[PatternItem]> patterns;
    in property <[TrackItem]> tracks;
    in property <[ArrangementItem]> arrangement-items;
    callback track-selected(int); callback arrangement-toggle(); callback resolution-invoked();
    callback step-invoked(int); callback pattern-invoked(int, bool); callback pattern-create(bool);
    callback step-edit(string); callback arrangement-item-invoked(int);
    callback step-page(int); callback playhead-follow-changed(bool);
    callback advanced-step-edit(string, int); callback condition-cycle();
    callback lock-parameter-cycle(int); callback lock-edit(string, int);
    callback track-item-selected(int); callback track-manage(string);
    callback pattern-manage(string);
    callback arrangement-manage(string);
    callback text-requested(string, string);
    spacing: 6px;
    HorizontalLayout { height: 44px; spacing: 5px;
        PageButton { text: "Steps"; selected: !root.arrangement-view; implemented: true; clicked => { if (root.arrangement-view) { root.arrangement-toggle(); } } }
        PageButton { text: "Arrangement"; selected: root.arrangement-view; implemented: true; clicked => { if (!root.arrangement-view) { root.arrangement-toggle(); } } }
        PageButton { text: root.selected-track; implemented: true; clicked => { root.track-selected(1); } }
        PageButton { text: root.selected-pattern; implemented: true; clicked => { } }
        PageButton { text: root.pattern-length; implemented: true; clicked => { root.pattern-manage("length-up"); } }
        PageButton { text: root.step-resolution; implemented: true; clicked => { root.resolution-invoked(); } }
        PageButton { text: root.page-label; implemented: root.can-page-next; clicked => { root.step-page(1); } }
    }
    if !root.arrangement-view: HorizontalLayout { spacing: 6px; vertical-stretch: 1;
        Rectangle { background: Theme.panel; border-radius: Theme.radius; horizontal-stretch: 4; VerticalLayout { padding: 8px; spacing: 6px;
            HorizontalLayout { height: 34px; spacing: 4px; PageButton { text: "Previous"; implemented: root.can-page-previous; clicked => { root.step-page(-1); } } Text { text: root.page-label; color: Theme.foreground; horizontal-alignment: center; vertical-alignment: center; } PageButton { text: "Next"; implemented: root.can-page-next; clicked => { root.step-page(1); } } PageButton { text: root.playhead-follow ? "Follow On" : "Follow Off"; implemented: true; selected: root.playhead-follow; clicked => { root.playhead-follow-changed(!root.playhead-follow); } } }
            GridLayout { vertical-stretch: 1; spacing: 6px; for step[i] in root.steps: PerformanceSlot { row: i / 8; col: mod(i, 8); label: step.label + (step.playhead ? " >" : ""); state: step.status; selected: step.selected; available: step.available; invoked => { root.step-invoked(i); } } }
        } }
        VerticalLayout { spacing: 5px; horizontal-stretch: 2;
            Rectangle { background: Theme.panel; border-radius: Theme.radius; vertical-stretch: 1; VerticalLayout { padding: 4px; Text { text: "Tracks"; color: Theme.accent; } HorizontalLayout { for track[i] in root.tracks: PageButton { height: 30px; text: track.name + (track.muted ? " [M]" : "") + (track.solo ? " [S]" : "") + (track.record-armed ? " [R]" : "") + (!track.effectively-audible ? " [–]" : ""); selected: track.selected; implemented: true; clicked => { root.track-item-selected(i); } } } HorizontalLayout { height: 30px; PageButton { text: "Mute"; implemented: true; clicked => { root.track-manage("mute"); } } PageButton { text: "Solo"; implemented: true; clicked => { root.track-manage("solo"); } } PageButton { text: "Arm"; implemented: true; clicked => { root.track-manage("arm"); } } PageButton { text: "Clear S"; implemented: true; clicked => { root.track-manage("clear-solo"); } } PageButton { text: "Clear R"; implemented: true; clicked => { root.track-manage("clear-arm"); } } PageButton { text: "Panic"; implemented: true; clicked => { root.track-manage("panic"); } } } HorizontalLayout { height: 30px; PageButton { text: "+Sample"; implemented: true; clicked => { root.track-manage("create-sample"); } } PageButton { text: "+Synth"; implemented: true; clicked => { root.track-manage("create-synth"); } } PageButton { text: "Rename"; implemented: true; clicked => { root.text-requested("track-rename", root.selected-track); } } PageButton { text: "Copy"; implemented: true; clicked => { root.track-manage("duplicate"); } } PageButton { text: root.confirm-delete-track ? "Confirm" : "Delete"; implemented: true; clicked => { root.track-manage(root.confirm-delete-track ? "confirm-delete" : "delete"); } } } } }
            Rectangle { background: Theme.panel; border-radius: Theme.radius; vertical-stretch: 2; VerticalLayout { padding: 5px; spacing: 4px; Text { text: "Patterns"; color: Theme.accent; } for pattern[i] in root.patterns: PageButton { height: 32px; text: pattern.name + (pattern.queued ? " [Q]" : pattern.active ? " [A]" : ""); selected: pattern.selected; implemented: true; clicked => { root.pattern-invoked(i, false); } } } }
            HorizontalLayout { height: 34px; spacing: 4px; PageButton { text: "New"; implemented: true; clicked => { root.pattern-create(false); } } PageButton { text: "Rename"; implemented: root.patterns.length > 0; clicked => { root.text-requested("pattern-rename", root.selected-pattern); } } PageButton { text: "Duplicate"; implemented: true; clicked => { root.pattern-create(true); } } PageButton { text: "Queue"; implemented: root.patterns.length > 0; clicked => { root.pattern-manage("launch"); } } PageButton { text: root.confirm-delete-pattern ? "Confirm" : "Delete"; implemented: root.patterns.length > 0; clicked => { root.pattern-manage(root.confirm-delete-pattern ? "confirm-delete" : "delete"); } } }
            VerticalLayout { spacing: 2px; height: 50px; Text { text: "Vel " + root.selected-velocity + "  Dur " + root.selected-duration + "  Pitch " + root.selected-pitch + "  Prob " + root.selected-probability; color: Theme.foreground; vertical-alignment: center; overflow: elide; } Text { text: root.selected-condition + "  Ratchet " + root.selected-ratchet + "  Timing " + root.selected-timing + "  " + root.lock-parameter + ": " + root.lock-value; color: Theme.muted; vertical-alignment: center; overflow: elide; } }
            HorizontalLayout { height: 32px; spacing: 3px; PageButton { text: "Vel -"; implemented: true; clicked => { root.advanced-step-edit("velocity", -1); } } PageButton { text: "Vel +"; implemented: true; clicked => { root.advanced-step-edit("velocity", 1); } } PageButton { text: "Prob -"; implemented: true; clicked => { root.advanced-step-edit("probability", -1); } } PageButton { text: "Prob +"; implemented: true; clicked => { root.advanced-step-edit("probability", 1); } } PageButton { text: "Condition"; implemented: true; clicked => { root.condition-cycle(); } } }
            HorizontalLayout { height: 32px; spacing: 3px; PageButton { text: "Ratchet -"; implemented: true; clicked => { root.advanced-step-edit("ratchet", -1); } } PageButton { text: "Ratchet +"; implemented: true; clicked => { root.advanced-step-edit("ratchet", 1); } } PageButton { text: "Lock Target"; implemented: root.lock-available; clicked => { root.lock-parameter-cycle(1); } } PageButton { text: "Lock -"; implemented: root.lock-available; clicked => { root.lock-edit("adjust", -1); } } PageButton { text: "Lock +"; implemented: root.lock-available; clicked => { root.lock-edit("adjust", 1); } } }
            HorizontalLayout { height: 32px; spacing: 3px; PageButton { text: "Dur -"; implemented: true; clicked => { root.advanced-step-edit("duration", -1); } } PageButton { text: "Dur +"; implemented: true; clicked => { root.advanced-step-edit("duration", 1); } } PageButton { text: "Pitch -"; implemented: true; clicked => { root.advanced-step-edit("pitch", -1); } } PageButton { text: "Pitch +"; implemented: true; clicked => { root.advanced-step-edit("pitch", 1); } } PageButton { text: "Time -"; implemented: true; clicked => { root.advanced-step-edit("timing", -1); } } PageButton { text: "Time +"; implemented: true; clicked => { root.advanced-step-edit("timing", 1); } } PageButton { text: "Clear Lock"; implemented: root.lock-available; clicked => { root.lock-edit("remove", 0); } } }
        }
    }
    if root.arrangement-view: VerticalLayout { spacing: 5px;
        Rectangle { height: 36px; background: Theme.panel; HorizontalLayout { padding: 3px; spacing: 4px; Text { text: "Loop: " + root.arrangement-loop; color: Theme.foreground; vertical-alignment: center; horizontal-stretch: 1; } PageButton { text: "+ Pattern"; implemented: root.patterns.length > 0; clicked => { root.arrangement-manage("create-pattern"); } } PageButton { text: "+ Audio"; implemented: root.tracks.length > 0; clicked => { root.arrangement-manage("create-audio"); } } PageButton { text: "Loop Start"; implemented: true; clicked => { root.arrangement-manage("loop-start"); } } PageButton { text: "Loop End"; implemented: true; clicked => { root.arrangement-manage("loop-end"); } } PageButton { text: "Loop On/Off"; implemented: true; clicked => { root.arrangement-manage("loop-toggle"); } } } }
        if root.arrangement-items.length == 0: EmptyState { title: "Arrangement"; message: "No pattern or audio clips are placed in the arrangement."; }
        for clip[i] in root.arrangement-items: PageButton { height: 38px; text: clip.kind + "  " + clip.label + "  " + clip.range; selected: clip.selected; implemented: clip.enabled; clicked => { root.arrangement-item-invoked(i); } }
        HorizontalLayout { height: 38px; spacing: 4px;
            PageButton { text: "Move -"; implemented: root.arrangement-items.length > 0; clicked => { root.arrangement-manage("move-left"); } }
            PageButton { text: "Move +"; implemented: root.arrangement-items.length > 0; clicked => { root.arrangement-manage("move-right"); } }
            PageButton { text: "Shorter"; implemented: root.arrangement-items.length > 0; clicked => { root.arrangement-manage("shorter"); } }
            PageButton { text: "Longer"; implemented: root.arrangement-items.length > 0; clicked => { root.arrangement-manage("longer"); } }
            PageButton { text: "Duplicate"; implemented: root.arrangement-items.length > 0; clicked => { root.arrangement-manage("duplicate"); } }
            PageButton { text: "Play From"; implemented: root.arrangement-items.length > 0; clicked => { root.arrangement-manage("seek"); } }
            PageButton { text: root.confirm-delete-clip ? "Confirm Delete" : "Delete"; implemented: root.arrangement-items.length > 0; clicked => { root.arrangement-manage(root.confirm-delete-clip ? "confirm-delete" : "delete"); } }
            if root.confirm-delete-clip: PageButton { text: "Cancel"; implemented: true; clicked => { root.arrangement-manage("cancel-delete"); } }
        }
    }
}
