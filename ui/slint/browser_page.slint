import { PageButton, EmptyState, ParameterDisplay } from "components.slint";
import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";

export struct BrowserEntryItem { name: string, kind: string, metadata: string, directory: bool, compatible: bool, selected: bool }

export component BrowserPage inherits Rectangle {
    background: Theme.background;
    in property <string> category: "projects"; in property <string> location;
    in property <string> destination; in property <string> preview;
    in property <string> sort-mode: "name"; in property <string> error;
    in property <bool> truncated: false; in property <bool> loading: false;
    in property <string> page-label: "Page 1/1";
    in property <bool> can-previous-page: false; in property <bool> can-next-page: false;
    in property <[BrowserEntryItem]> entries; in property <[string]> missing-assets;
    in property <int> selected-missing: 0; in property <string> filter-text;
    callback category-selected(string); callback parent-requested(); callback entry-selected(int);
    callback entry-activated(); callback filter-requested(string); callback sort-requested();
    callback project-action(string, string); callback preset-action(string);
    callback page-requested(int); callback refresh-requested(); callback text-requested(string, string);
    callback missing-selected(int); callback relink-requested(bool);
    VerticalLayout { padding: 6px; spacing: 5px;
        HorizontalLayout { height: 40px; spacing: 4px;
            PageButton { text: "Projects"; selected: root.category == "projects"; clicked => { root.category-selected("projects"); } }
            PageButton { text: "Samples"; selected: root.category == "samples"; clicked => { root.category-selected("samples"); } }
            PageButton { text: "Instrument Presets"; selected: root.category == "instrument-presets"; clicked => { root.category-selected("instrument-presets"); } }
            PageButton { text: "FX Presets"; selected: root.category == "fx-presets"; clicked => { root.category-selected("fx-presets"); } }
            PageButton { text: "Other"; selected: root.category == "other"; clicked => { root.category-selected("other"); } }
        }
        HorizontalLayout { height: 40px; spacing: 4px;
            PageButton { text: "Parent"; clicked => { root.parent-requested(); } }
            PageButton { horizontal-stretch: 3; text: root.filter-text == "" ? "Filter…" : "Filter: " + root.filter-text; clicked => { root.text-requested("browser-filter", root.filter-text); } }
            PageButton { text: "Sort: " + root.sort-mode; clicked => { root.sort-requested(); } }
            PageButton { text: "Refresh"; clicked => { root.refresh-requested(); } }
        }
        Text { height: 26px; text: root.location; color: Theme.muted; overflow: elide; }
        HorizontalLayout { vertical-stretch: 1; spacing: 6px;
            Rectangle { horizontal-stretch: 2; background: Theme.panel; border-radius: Theme.radius;
                ScrollView { VerticalLayout { padding: 5px; spacing: 3px;
                    for entry[i] in root.entries: PageButton { height: 42px; text: (entry.directory ? "▸ " : "") + entry.name + "  —  " + entry.kind + (entry.metadata == "" ? "" : " — " + entry.metadata); selected: entry.selected; implemented: entry.compatible; clicked => { root.entry-selected(i); } }
                    if root.entries.length == 0: EmptyState { title: "No compatible content"; message: "Choose another category or location."; }
                } }
            }
            Rectangle { horizontal-stretch: 1; background: Theme.panel; border-radius: Theme.radius;
                VerticalLayout { padding: 6px; spacing: 5px;
                    ParameterDisplay { name: "Selected content"; value: root.preview; }
                    ParameterDisplay { name: "Destination"; value: root.destination; }
                    PageButton { text: "Open / Apply"; implemented: root.entries.length > 0; clicked => { root.entry-activated(); } }
                    if root.category == "projects": PageButton { text: "Save"; clicked => { root.project-action("save", ""); } }
                    if root.category == "projects": PageButton { text: "Save As…"; clicked => { root.text-requested("project-save-as", ""); } }
                    if root.category == "projects": PageButton { text: "New Project…"; clicked => { root.text-requested("project-new", "Untitled"); } }
                    if root.category == "instrument-presets" || root.category == "fx-presets": PageButton { text: "Validate"; implemented: root.entries.length > 0; clicked => { root.preset-action("validate"); } }
                    if root.category == "instrument-presets" || root.category == "fx-presets": PageButton { text: "Save Current…"; clicked => { root.text-requested(root.category == "fx-presets" ? "preset-capture-fx" : "preset-capture-sound", "New Preset"); } }
                    if root.category == "instrument-presets" || root.category == "fx-presets": HorizontalLayout { height: 36px; PageButton { text: "Rename…"; implemented: root.entries.length > 0; clicked => { root.preset-action("rename"); } } PageButton { text: "Duplicate…"; implemented: root.entries.length > 0; clicked => { root.preset-action("duplicate"); } } }
                    if root.category == "instrument-presets" || root.category == "fx-presets": HorizontalLayout { height: 36px; PageButton { text: "Update"; implemented: root.entries.length > 0; clicked => { root.preset-action("update"); } } PageButton { text: "Delete"; implemented: root.entries.length > 0; clicked => { root.preset-action("delete"); } } }
                    if root.category == "instrument-presets" || root.category == "fx-presets": PageButton { text: "Export Portable…"; implemented: root.entries.length > 0; clicked => { root.preset-action("export-portable"); } }
                    HorizontalLayout { height: 34px; PageButton { text: "Previous"; implemented: root.can-previous-page; clicked => { root.page-requested(-1); } } Text { text: root.page-label; color: Theme.foreground; vertical-alignment: center; horizontal-alignment: center; } PageButton { text: "Next"; implemented: root.can-next-page; clicked => { root.page-requested(1); } } }
                    Text { text: root.loading ? "Loading…" : root.truncated ? "Listing changed; refresh to continue." : ""; color: Theme.muted; wrap: word-wrap; }
                    if root.missing-assets.length > 0: Text { text: "Missing assets"; color: Theme.warning; }
                    for missing[i] in root.missing-assets: PageButton { height: 32px; text: missing; selected: i == root.selected-missing; clicked => { root.missing-selected(i); } }
                    if root.missing-assets.length > 0: HorizontalLayout { height: 36px; PageButton { text: "Use selected file"; implemented: root.entries.length > 0; clicked => { root.relink-requested(false); } } PageButton { text: "Map this folder"; clicked => { root.relink-requested(true); } } }
                    Text { text: root.error; color: #ff8080; wrap: word-wrap; }
                }
            }
        }
    }
}
